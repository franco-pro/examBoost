{
  "expo": {
    "name": "ExamBoost",
    "slug": "examboost",
    "owner": "lefutes-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "examboost",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
     "jsEngine": "hermes",
    "packagerOpts": {
      "config": {
        "blacklistRE": [
          "/[/\\].vscode[/\\]/"
        ],
        "blocklistRE": [
          "/[/\\].vscode[/\\]/"
        ]
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.genesys.examBoost",
      "icon": {
        "light": "./app/assets/icons/ios-light.png",
        "dark": "./app/assets/icons/ios-dark.png",
        "tinted": "./app/assets/icons/ios-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "softwareKeyboardLayoutMode": "pan"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.genesys.examBoost"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/icons/splash-icon-dark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./app/assets/icons/splash-icon-light.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a5037bc-9bfe-4fe8-bdb2-dd20bae476f4"
      }
    }
  }
}
